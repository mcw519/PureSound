.vscode/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Type checking and test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
__pycache__/
*.egg

# Logs and local runtime artifacts
*.log

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Project-specific generated outputs
test/test_case/outputs/

# Experimental and temporary files
exp
exp/
proc/
.gradio/
data/
dummy_samples/
eval_set*/
data_report/
backup/
anna_test.wav

# Recipe configs stay in version control even when their directory name matches one
# of the output patterns above: egs/*/config/exp holds experiment recipes, not runs.
!egs/*/config/exp/
!egs/*/config/exp/*.yaml

# PRIVATE BENCHMARK AUDIO -- never version-controlled, never redistributed.
# These are internal field recordings (and one set carrying a commercial system's
# output). Their labels and scorecards live under egs/*/benchmarks/ and carry no
# audio; the recordings themselves are distributed out of band. Do not add negative
# rules under these paths.
egs/voice_isolate/test_vector/
egs/voice_isolate/data_report/field_cases/
egs/voice_isolate/data_report/qvf22_real_cases/
*.wav.private

# Keep the RIR realism artifact index visible while ignoring generated payloads.
!egs/rir_generation/exp/
!egs/rir_generation/exp/rir_realism/
egs/rir_generation/exp/rir_realism/*
!egs/rir_generation/exp/rir_realism/README.md
EXPERIMENT_LOG.md
FAILED_NOTE.md
NEXT_STEPS.md
robot_foreground_voice_full_plan.md
