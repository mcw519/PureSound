.vscode/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Type checking and test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
__pycache__/
*.egg

# Logs and local runtime artifacts
*.log

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Project-specific generated outputs
test/test_case/outputs/

# Do not accidentally publish newly produced training checkpoints. Release
# checkpoints already tracked by Git remain tracked; adding a new release model
# must be an explicit `git add -f` decision.
egs/voice_isolate/pretrained_ckpt/*.ckpt

# Experimental and temporary files
exp
exp/
proc/
.gradio/
data/
dummy_samples/
eval_set*/
data_report/
backup/
anna_test.wav

# `config/exp` is for local experiment recipes and stays out of version control.
# The released recipes live directly under `egs/*/config/` and `config/eval/`.
egs/*/config/exp/

# PRIVATE BENCHMARK AUDIO -- never version-controlled, never redistributed.
# These are internal field recordings (and one set carrying a commercial system's
# output), distributed out of band. Their labels and scorecards are internal too:
# see `_internal/` below. Do not add negative rules under these paths.
egs/voice_isolate/test_vec/
egs/voice_isolate/data_report/field_cases/
*.wav.private

# Keep the RIR realism artifact index visible while ignoring generated payloads.
!egs/rir_generation/exp/
!egs/rir_generation/exp/rir_realism/
egs/rir_generation/exp/rir_realism/*
!egs/rir_generation/exp/rir_realism/README.md
EXPERIMENT_LOG.md
FAILED_NOTE.md
NEXT_STEPS.md
robot_foreground_voice_full_plan.md

# Internal-only material pulled out of the public release (2026-09-12): experiment
# records, round narratives, agent-written audits, and capture identifiers. The files
# are kept on disk under `_internal/`, mirroring their old paths, so the history they
# document stays reachable locally without shipping in the release.
_internal/
egs/voice_isolate/benchmarks/

# Coding-agent working directories.
.agents/
.codex/
