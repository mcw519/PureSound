.vscode/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Type checking and test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
__pycache__/
*.egg

# Logs and local runtime artifacts
*.log

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Project-specific generated outputs
test/test_case/outputs/

# Experimental and temporary files
exp
exp/
proc/
.gradio/
data/
dummy_samples/
eval_set*/
data_report/
backup/
anna_test.wav

# Recipe configs stay in version control even when their directory name matches one
# of the output patterns above: egs/*/config/exp holds experiment recipes, not runs.
!egs/*/config/exp/
!egs/*/config/exp/*.yaml
EXPERIMENT_LOG.md
FAILED_NOTE.md
NEXT_STEPS.md
robot_foreground_voice_full_plan.md
