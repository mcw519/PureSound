  "voice-isolate-dpcrn-curriculum-v1": {
   "display_name": "Voice Isolation DPCRN curriculum v1",
   "task": "voice_isolation",
   "lifecycle": "released",
   "roles": [
    "default"
   ],
   "description": "Suppresses a distant talker further than any earlier version -- including from a cold start -- at no cost to the near talker, on the capture hardware it was tuned for. On other capture hardware it can attenuate the near talker; prefer dpcrn-v8 when the capture path is unknown.",
