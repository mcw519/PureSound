  "noise-suppression-dpcrn-mamba-v2": {
   "display_name": "Noise Suppression DPCRN-Mamba v2",
   "task": "noise_suppression",
   "lifecycle": "released",
   "roles": [
    "default"
   ],
   "description": "Single-channel 16 kHz streaming noise suppression (DPCRN-Mamba), v1 fine-tuned with a MetricGAN PESQ critic. On VCTK-DEMAND PESQ-WB 2.57 and on DNS-5 DNSMOS OVR 2.83; on a harder WER set it deletes fewer words than v1, on VCTK-DEMAND slightly more -- prefer v1 if that matters.",
   "recommended_inference": {
    "dry_blend": 1.0
   },
   "card": "egs/noise_suppression/pretrained_ckpt/README.md",
   "artifacts": {
    "default": {
