    },
    "flash": {
     "file": "dpcrn_mamba_v2_flash.onnx",
     "description": "int8 weights for tight CPU budgets: about 11% less CPU time, PESQ within 0.004, no resolvable change in word deletions.",
     "size_bytes": 1123438
    }
   }
  },
  "noise-suppression-dpcrn-mamba-v3": {
   "display_name": "Noise Suppression DPCRN-Mamba v3",
   "task": "noise_suppression",
   "lifecycle": "released",
   "roles": [
    "candidate"
   ],
   "description": "Wider 16 kHz streaming DPCRN-Mamba with mixed-source coverage training, calibrated against a PESQ critic and the DNSMOS P.835 judge. Higher PESQ, STOI and DNSMOS than v2 at 1.5x the CPU. Deletion gates remain unresolved, and hard-set WER is above the unprocessed input.",
   "recommended_inference": {
    "dry_blend": 1.0
   },
   "card": "egs/noise_suppression/pretrained_ckpt/README.md",
   "artifacts": {
